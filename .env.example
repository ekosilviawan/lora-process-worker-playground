APP_NAME=lpw-playground
# local|dev|uat|sit|prod
APP_ENV=local

# trace|debug|info|warn|error|disabled
LOGGER_LEVEL=debug

# Schema service
LORA_SCHEMA_BASE_SERVER_URL=http://127.0.0.1:8080
LORA_SCHEMA_BASE_PATH=

# Gateway service (required by the SDK's system init; no activities call it, but it must be reachable)
LORA_GATEWAY_BASE_SERVER_URL=http://127.0.0.1:8081
LORA_GATEWAY_API_SECRET=

# Temporal
TEMPORAL_HOST=127.0.0.1
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=

# ArangoDB
ARANGODB_URL=http://127.0.0.1:8529
ARANGODB_USER_NAME=root
ARANGODB_PASSWORD=rootpassword
ARANGODB_DATABASE=worker_playground
